{
  "name": "my-projects",
  "version": "1.4.0",
  "description": "VLAUTR: local-first password generator and encrypted password vault",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "test": "node --test",
    "dist": "electron-builder",
    "dist:setup": "electron-builder --win nsis",
    "icon": "electron scripts/render-icon.js"
  },
  "keywords": [],
  "author": "VLAUTR",
  "license": "ISC",
  "type": "commonjs",
  "devDependencies": {
    "electron": "^44.2.0",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "com.mazen.passwordgenerator",
    "productName": "VLAUTR",
    "publish": null,
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "ipc-handlers.js",
      "preload.js",
      "renderer.js",
      "backup-codes.js",
      "csv-transfer.js",
      "csv-ui.js",
      "csv-ui.css",
      "page.html",
      "vault.js",
      "package.json",
      "build/icon.ico"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowElevation": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "VLAUTR",
      "uninstallDisplayName": "VLAUTR",
      "deleteAppDataOnUninstall": false,
      "differentialPackage": false
    }
  },
  "dependencies": {
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/ibm-plex-sans": "^5.3.0"
  }
}
